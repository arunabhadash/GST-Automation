// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RTO_INITIATED
  RTO_DELIVERED
}

enum IntegrationType {
  E_COMMERCE
  LOGISTICS
}

enum IntegrationStatus {
  CONNECTED
  NEEDS_REAUTH
  NOT_CONNECTED
}

enum CreditNoteStatus {
  PENDING
  IN_PROCESS
  COMPLETED
}

enum SourcePlatform {
  SHOPIFY
  WOOCOMMERCE
}

// --- NextAuth Models ---
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]

  // Relations
  orders         Order[]
  integrations   Integration[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain Models ---
model Order {
  id                   String        @id
  userId               String
  source               SourcePlatform
  customerName         String
  products             String
  orderValue           Decimal       @db.Decimal(18, 2)
  taxAmount            Decimal       @db.Decimal(18, 2)
  status               OrderStatus
  originalInvoiceDate  DateTime
  rtoDate              DateTime?
  shippingFee          Decimal       @db.Decimal(18, 2)
  rtoCost              Decimal       @db.Decimal(18, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditNotes          CreditNote[]

  @@index([userId])
}

model CreditNote {
  id        String           @id @default(cuid())
  orderId   String
  amount    Decimal          @db.Decimal(18, 2)
  status    CreditNoteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Integration {
  id        String            @id @default(cuid())
  userId    String
  name      String
  type      IntegrationType
  status    IntegrationStatus @default(NOT_CONNECTED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
